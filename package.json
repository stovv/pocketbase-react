{
  "name": "@stovv/pocketbase-react",
  "version": "1.0.0",
  "description": "Unofficial React SDK (React, React Native, Expo) for interacting with the PocketBase JS SDK",
  "keywords": [
    "pocketbase",
    "react",
    "react-native",
    "expo",
    "sdk",
    "javascript",
    "typescript",
    "javascript-sdk"
  ],
  "license": "MIT",
  "author": "Tobias Krainhöfner",
  "homepage": "https://github.com/tobicrain/pocketbase-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobicrain/pocketbase-react.git"
  },
  "bugs": {
    "url": "https://github.com/tobicrain/pocketbase-react/issues"
  },
  "main": "lib/index.js",
  "types": "es/index.d.ts",
  "unpkg": "dist/pocketbase-react.js",
  "module": "es/index.js",
  "files": ["dist", "lib", "src", "es"],
  "scripts": {
    "build:commonjs": "cross-env BABEL_ENV=commonjs babel src --extensions \".js,.ts,.tsx\" --out-dir lib",
    "build:es": "babel src --extensions \".js,.ts,.tsx\" --out-dir es",
    "build:umd": "cross-env NODE_ENV=development rollup -c -o dist/pocketbase-react.js",
    "build:umd:min": "cross-env NODE_ENV=production rollup -c -o dist/pocketbase-react.min.js",
    "build:types": "tsc",
    "build": "yarn build:types && yarn build:commonjs && yarn build:es && yarn build:umd && yarn build:umd:min",
    "clean": "rimraf lib dist es coverage",
    "dev": "rollup -c -w",
    "rollup": "rollup -c",
    "prepublishOnly": "npm run build",
    "docs:dev": "docsify serve docs",
    "docs:build": "docsify-build docs -o docs/dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "update-coverage": "node scripts/update-coverage.js",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src"
  },
  "peerDependencies": {
    "pocketbase": "^0.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/core": "^7.19.3",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.12.1",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-react-jsx": "^7.12.1",
    "@babel/plugin-transform-runtime": "^7.12.1",
    "@babel/preset-env": "^7.12.1",
    "@babel/preset-typescript": "^7.14.5",
    "@biomejs/biome": "^1.9.4",
    "@rollup/plugin-babel": "^5.2.1",
    "@rollup/plugin-commonjs": "^15.1.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-replace": "^2.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/lodash.clonedeep": "^4",
    "@types/lodash.omit": "^4.5.9",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitest/coverage-v8": "3.1.3",
    "@vitest/ui": "^3.1.3",
    "cross-env": "^7.0.3",
    "docsify-cli": "^4.4.4",
    "jsdom": "^26.1.0",
    "rollup": "^2.32.1",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^4.3.4",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@reduxjs/toolkit": "^2.8.0",
    "crypto": "1.0.1",
    "deepmerge": "4.3.1",
    "lodash.clonedeep": "4.5.0",
    "lodash.omit": "^4.5.0",
    "pocketbase": "^0.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-fast-compare": "^3.2.2",
    "react-redux": "^9.0.0",
    "redux-persist": "^6.0.0"
  },
  "packageManager": "yarn@4.9.1"
}
